{
  "name": "interface-ai-computer-use",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-controlled computer-use automation with deterministic replay.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/cli/dev.ts",
    "smoke": "node --import tsx src/cli/smoke.ts",
    "discover": "node --env-file-if-exists=.env --import tsx src/cli/discover.ts",
    "compile-artifact": "node --import tsx src/cli/compile-artifact.ts",
    "freeze-replay-evidence": "node --import tsx src/cli/freeze-replay-evidence.ts",
    "hitl-demo": "node --env-file-if-exists=.env --import tsx src/cli/run-hitl-demo.ts",
    "freeze-human-handoff-evidence": "node --import tsx src/cli/freeze-human-handoff-evidence.ts",
    "intervention:list": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts list",
    "intervention:show": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts show",
    "intervention:acquire": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts acquire",
    "intervention:start": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts start",
    "intervention:manual-action": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts manual-action",
    "intervention:resume": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts resume",
    "intervention:abort": "node --env-file-if-exists=.env --import tsx src/cli/intervention-cli.ts abort",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify-human-handoff-evidence": "node --import tsx src/cli/verify-human-handoff-evidence.ts"
  },
  "dependencies": {
    "openai": "^7.15.0",
    "playwright": "1.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
